{
    "name": "voodflow/vmedia",
    "description": "Media Vault for the Voodflow plugin family (Filament 5 + Spatie Media Library). Standalone admin/API/galleries; integrates with VoodBuilder Asset Manager.",
    "version": "0.2.5",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "media",
        "gallery",
        "spatie",
        "voodflow",
        "vmedia"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-sluggable": "^3.0"
    },
    "suggest": {
        "voodflow/voodbuilder": "Optional: page builder Asset Manager lists/uploads into galleries."
    },
    "autoload": {
        "psr-4": {
            "Voodflow\\Vmedia\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Voodflow\\Vmedia\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voodflow\\Vmedia\\VmediaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
