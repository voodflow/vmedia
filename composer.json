{
    "name": "voodflow/voodbuilder-media",
    "description": "Reusable media library & galleries for Filament 5 (Spatie Media Library). Works standalone; first-class VoodBuilder editor integration.",
    "version": "0.0.1",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "voodbuilder",
        "media",
        "gallery",
        "spatie",
        "voodflow"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-sluggable": "^3.0"
    },
    "suggest": {
        "voodflow/voodbuilder": "Page builder integration: editor Asset Manager lists/uploads into galleries."
    },
    "autoload": {
        "psr-4": {
            "Voodflow\\VoodbuilderMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voodflow\\VoodbuilderMedia\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voodflow\\VoodbuilderMedia\\VoodbuilderMediaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
